# Sviluppo: senza impostazioni DB si usa instance/negozio.sqlite.
APP_ENV=development
# In produzione: APP_ENV=production e SECRET_KEY stabile e casuale.
# SECRET_KEY=

# TiDB: compilare tutte queste variabili nel proprio .env, mai in Git.
# DB_HOST=
# DB_PORT=4000
# DB_USER=
# DB_PASS=
# DB_NAME=
# DB_SSL_CA=certs/tidb-ca.pem

# Alternativa per sviluppo/test (ha precedenza su DB_HOST):
# DATABASE_URL=sqlite:///negozio.sqlite
